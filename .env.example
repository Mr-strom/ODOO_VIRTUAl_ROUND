# Flask Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-32-character-secret-in-production

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///dayflow.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/dayflow

# JWT Token Expiry (in hours)
JWT_EXPIRY_HOURS=24

# Allowed CORS Origins (comma-separated for React SPA)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
